# Configuración del microservicio ML (opcional).
# Copiar como backend/ml_service/.env solo si se necesita sobreescribir los valores por defecto.
#
# Puerto local de uvicorn. Si no se define, el servicio arranca en 8000,
# que es donde el backend Node lo busca (ML_SERVICE_URL en backend/.env).
# En Azure App Service NO se define: la plataforma inyecta PORT y ese manda.
ML_PORT=8000

# Si se define aquí, tiene prioridad sobre la DATABASE_URL de backend/.env.
# Si se omite, el microservicio toma DATABASE_URL (y solo esa variable) de backend/.env.
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
